# Copy this file to .env and fill in the values. NEVER commit .env (it is in .gitignore).
# On Render, set these under the service's Environment tab instead.
PORT=5000
NODE_ENV=production
MONGO_URI=
JWT_SECRET=                 # 64+ random characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYSTACK_SECRET_KEY=
SUPER_ADMIN_EMAILS=
FRONTEND_URL=https://mylogbase.com
CORS_ORIGIN=                # https://mylogbase.com,https://www.mylogbase.com
TRUST_PROXY=1               # 1 behind Render's proxy
RESEND_API_KEY=
MAIL_FROM=LogBase <no-reply@mylogbase.com>
PROGRAMME_DESK_PHONE=
